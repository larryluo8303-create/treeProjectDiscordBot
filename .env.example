DISCORD_BOT_TOKEN=your_bot_token_here
OPENAI_API_KEY=your_openai_api_key_here
OWNER_USER_ID=your_discord_user_id_here
TARGET_CHANNEL_IDS=channel_id_1,channel_id_2
EXCLUDED_CHANNEL_IDS=

# OpenAI model settings
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
VISION_MODEL=gpt-4o
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.7

# RAG settings
RAG_TOP_K=8
RAG_MAX_DISTANCE=0.8
CONFIDENCE_THRESHOLD=7

# Response mode: "auto" (confidence routing) or "review" (always forward to owner)
RESPOND_MODE=auto

# Conversation memory
CONVERSATION_MEMORY_SIZE=10
CONVERSATION_MEMORY_TTL=3600

# Rate limiting
USER_COOLDOWN_SECONDS=30
GLOBAL_MAX_PER_MINUTE=10

# Offline backfill
OFFLINE_BACKFILL_ENABLED=true
OFFLINE_BACKFILL_LOOKBACK_HOURS=12
OFFLINE_BACKFILL_MAX_PER_CHANNEL=100
OFFLINE_BACKFILL_OWNER_REPLY_WINDOW_MINUTES=15
OFFLINE_LAST_SEEN_FILE=data/last_seen.json

# Paths
CHROMADB_PATH=./chromadb_store
CHROMADB_COLLECTION=bigtree_knowledge
EXPORT_DIR=./data/exports

# Ingestion
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
EMBED_BATCH_SIZE=100

# Thread support (auto-reply in threads whose parent channel is a target)
THREAD_AUTO_REPLY=true
THREAD_CONTEXT_MESSAGES=15

# Scheduled ingestion (0 = disabled; set to hours between runs)
INGEST_INTERVAL_HOURS=0
STYLE_INTERVAL_HOURS=0

# Daily digest (channel activity summary DM'd to owner)
DIGEST_ENABLED=false
DIGEST_HOUR=22
DIGEST_CHANNEL_ID=0

# Webhook integration (receive external data as knowledge input)
WEBHOOK_ENABLED=false
WEBHOOK_PORT=8081
WEBHOOK_SECRET=

# Admin web panel (stats, KB management, config dashboard)
ADMIN_ENABLED=false
ADMIN_PORT=8082
ADMIN_SECRET=

# Language (zh = Chinese, en = English)
BOT_LANGUAGE=zh

# Logging
LOG_LEVEL=INFO

# Health check (set to a port number to enable HTTP /health endpoint, 0 = disabled)
HEALTH_PORT=0

# ── BigTreeSignal Promotion ──
PROMO_ENABLED=true
PROMO_CHANNEL_IDS=channel_id_1,channel_id_2
SIGNAL_PRODUCT_NAME=BigTreeSignal
SIGNAL_PRODUCT_URL=https://your-product-url.com
SIGNAL_CTA_TEXT=想获取实时交易信号？了解 BigTreeSignal
AUTO_REPLY_CTA_TEXT=想获取实时交易信号？了解 BigTreeSignal →
CTA_FREQUENCY=5
FREE_TRIAL_ENABLED=false
FREE_TRIAL_URL=https://your-trial-url.com
WELCOME_MESSAGE=欢迎加入！这里是 BigTree 的股票分析社群。
WELCOME_FLOW_ENABLED=true
WELCOME_VALUE_DELAY_SECONDS=14400
WELCOME_CTA_DELAY_SECONDS=86400
WELCOME_REMINDER_DELAY_SECONDS=259200
INTENT_CONVERT_ENABLED=true
INTENT_NOTIFY_OWNER=true
INTENT_LEAD_ROLE_ID=0
INVITE_TRACKING_ENABLED=true
INVITE_REWARD_THRESHOLD=3
INVITE_REWARD_ROLE_ID=0
TESTIMONIAL_CHANNEL_ID=your_user_wins_channel_id
TESTIMONIAL_DETECTION_ENABLED=true

# Opt-in promo DMs (voluntary notify roles only — not ops/interest tags)
PROMO_NOTIFY_ROLE_IDS=
PROMO_DM_DELAY_SECONDS=1.2
PROMO_DM_MAX_RECIPIENTS=200

# ── Jin10 Market News Feed ──
NEWS_FEED_ENABLED=false
NEWS_CHANNEL_IDS=channel_id_1,channel_id_2
NEWS_POLL_INTERVAL_SECONDS=30
NEWS_IMPORTANT_ONLY=true
NEWS_BACKFILL_HOURS=24

# ── Weekly Summary (GPT-powered weekly summary of owner messages) ──
WEEKLY_SUMMARY_ENABLED=false
WEEKLY_SUMMARY_CHANNELS=channel_id_1,channel_id_2
WEEKLY_SUMMARY_DAY=5
WEEKLY_SUMMARY_HOUR=14
WEEKLY_SUMMARY_MINUTE=0
WEEKLY_SUMMARY_POST_CHANNELS=channel_id_1,channel_id_2

# ── Daily Summary (GPT-powered daily summary of owner messages, Mon–Fri) ──
DAILY_SUMMARY_ENABLED=false
DAILY_SUMMARY_CHANNELS=channel_id_1,channel_id_2
DAILY_SUMMARY_DAYS=0,1,2,3,4
DAILY_SUMMARY_HOUR=16
DAILY_SUMMARY_MINUTE=0
DAILY_SUMMARY_POST_CHANNELS=channel_id_1,channel_id_2

# ── FAQ Daily Push ──
FAQ_PUSH_ENABLED=false
FAQ_PUSH_HOUR=10                        # ET (UTC-4)
FAQ_PUSH_MINUTE=0
FAQ_PUSH_CHANNELS=channel_id_1

# ── Promo Monitor (auto schedule_promo when owner posts in source channel) ──
PROMO_MONITOR_ENABLED=false
PROMO_SOURCE_CHANNEL_ID=0
PROMO_PUSH_HOUR=16
PROMO_DURATION_DAYS=90
PROMO_PUSH_CHANNELS=channel_id_1,channel_id_2

# ── YouTube Monitor (auto schedule_lesson on new video) ──
YOUTUBE_MONITOR_ENABLED=false
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxx
YOUTUBE_POLL_INTERVAL=3600
YOUTUBE_CHECK_HOUR=9
YOUTUBE_CHECK_MINUTE=30
YOUTUBE_LESSON_PUSH_HOUR=16
YOUTUBE_LESSON_PUSH_CHANNELS=channel_id_1,channel_id_2
YOUTUBE_AUTO_INGEST=true
YOUTUBE_SUMMARY_CHANNELS=channel_id_1,channel_id_2

# ── Auto Moderation (spam / scam / ad auto-delete) ──
AUTO_MOD_ENABLED=false
AUTO_MOD_LOG_CHANNEL_ID=0
AUTO_MOD_EXEMPT_ROLE_IDS=
AUTO_MOD_MAX_MENTIONS=8
AUTO_MOD_MAX_LINKS=5
AUTO_MOD_DUP_WINDOW=60
AUTO_MOD_DUP_THRESHOLD=3
AUTO_MOD_BAN_WORDS_FILE=data/ban_words.json
AUTO_MOD_BAN_WORDS_SIMILARITY=0.82
TOPIC_RESTRICTED_CHANNEL_IDS=

# ── API Server (FastAPI) ──
API_ENABLED=true
API_PORT=8090
API_SECRET_KEY=change-me-in-production
API_USERNAME=admin
API_PASSWORD=admin
API_TOKEN_EXPIRE_MINUTES=1440

# ── Public Client API ──
CLIENT_API_ENABLED=true
CLIENT_API_KEY=
CLIENT_RATE_LIMIT_PER_MINUTE=20
